# ============================================
# RAG System - Configuración de Ejemplo
# ============================================
# Copia este archivo a .env y completa solo los campos necesarios

# --- GROQ API ---
# Obtén tu API key gratis en: https://console.groq.com
GROQ_API_KEY=tu_clave_api_de_groq_aquí

# --- QDRANT (obligatorio) ---
# Opción 1: Qdrant Cloud (recomendado para producción)
# Crea tu cluster gratis en: https://cloud.qdrant.io
QDRANT_URL=https://tu_cluster_id.europe-west3-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=tu_clave_api_de_qdrant_aquí

# Opción 2: Qdrant Local (solo desarrollo)
# Descomenta las siguientes líneas y comenta las de arriba:
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# --- Configuración Opcional ---
# Nombre de la colección (se creará automáticamente si no existe)
QDRANT_COLLECTION_NAME=rag_pdf_collection

# Modelo de embeddings (multilingüe, optimizado para español)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Directorio donde estarán tus PDFs
PDFS_DIR=./data/pdfs

# Tamaño de fragmentos de texto
CHUNK_SIZE=1000
CHUNK_OVERLAP=200